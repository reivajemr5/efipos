# Base de datos PostgreSQL (Supabase/Render). Rellena con tu URI real en .env
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto para firmar JWT. Genera uno fuerte: openssl rand -hex 32
JWT_SECRET=""

# Puerto del servidor
PORT=3001

# Origen permitido por CORS (frontend). Lista separada por comas, sin barra final.
FRONTEND_URL="http://localhost:5173"

# "production" activa cookies seguras (https)
NODE_ENV="development"