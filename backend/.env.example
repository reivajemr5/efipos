# Base de datos PostgreSQL (Supabase). Usa el connection pooler (IPv4, funciona en
# redes sin IPv6 como Render/Android). Sustituye <REF> por tu project ref de Supabase
# y usa el usuario "postgres.<REF>". Directo (db.<REF>.supabase.co:5432) es solo IPv6.
DATABASE_URL="postgresql://postgres.<REF>:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Secreto para firmar JWT. Genera uno fuerte: openssl rand -hex 32
JWT_SECRET=""

# Puerto del servidor
PORT=3001

# Origen permitido por CORS (frontend). Lista separada por comas, sin barra final.
FRONTEND_URL="http://localhost:5173"

# "production" activa cookies seguras (https)
NODE_ENV="development"