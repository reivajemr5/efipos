generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  dueno
  admin
  cajero
}

enum Currency {
  bs
  usd
}

enum InvoiceStatus {
  activa
  anulada
}

enum PurchaseStatus {
  pedido
  recibido
  pagada
  anulada
}

enum QuoteStatus {
  activa
  convertida
  vencida
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(cajero)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  invoices         Invoice[]
  quotes           Quote[]
  cashCloses       CashClose[]
  purchaseInvoices PurchaseInvoice[]

  @@map("users")
}

model Client {
  id             Int       @id @default(autoincrement())
  name           String
  documentType   String    @map("document_type")
  documentNumber String    @map("document_number")
  phone          String?
  address        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  invoices       Invoice[]
  quotes         Quote[]

  @@map("clients")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  documentType   String   @map("document_type")
  documentNumber String   @map("document_number")
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  products         ProductSupplier[]
  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model ProductBarcode {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String

  @@map("product_barcodes")
}

model Product {
  id          Int       @id @default(autoincrement())
  type        String    @default("simple")
  code        String    @unique
  name        String
  description String?
  notes       String?
  barcode     String?   @unique
  cost        Decimal?  @db.Decimal(12, 2)
  price       Decimal   @db.Decimal(12, 2)
  price2      Decimal?  @map("price_2") @db.Decimal(12, 2)
  currency    Currency  @default(bs)
  ivaPercent  Decimal   @default(16) @map("iva_percent") @db.Decimal(5, 2)
  stock       Int       @default(0)
  minStock    Int       @default(5) @map("min_stock")
  active      Boolean   @default(true)
  categoryId  Int?      @map("category_id")
  variations  Json?     @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  category    Category?                @relation(fields: [categoryId], references: [id])
  barcodes    ProductBarcode[]
  suppliers   ProductSupplier[]
  invoiceItems          InvoiceItem[]
  quoteItems            QuoteItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]

  @@map("products")
}

model ProductSupplier {
  productId  Int      @map("product_id")
  supplierId Int      @map("supplier_id")
  price      Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  rate      Decimal  @db.Decimal(14, 4)
  source    String   @default("bcv")
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("exchange_rates")
}

model Quote {
  id           Int          @id @default(autoincrement())
  number       String       @unique
  clientId     Int          @map("client_id")
  userId       Int          @map("user_id")
  currency     Currency     @default(usd)
  exchangeRate Decimal?     @map("exchange_rate") @db.Decimal(14, 4)
  subtotal     Decimal      @db.Decimal(12, 2)
  ivaTotal     Decimal      @map("iva_total") @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  totalBs      Decimal?     @map("total_bs") @db.Decimal(14, 2)
  status       QuoteStatus  @default(activa)
  validUntil   DateTime     @map("valid_until")
  createdAt    DateTime     @default(now()) @map("created_at")
  client       Client       @relation(fields: [clientId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        QuoteItem[]
  invoice      Invoice?     @relation("QuoteToInvoice")

  @@map("quotes")
}

model QuoteItem {
  id         Int     @id @default(autoincrement())
  quoteId    Int     @map("quote_id")
  productId  Int     @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  ivaPercent Decimal @map("iva_percent") @db.Decimal(5, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Invoice {
  id            Int            @id @default(autoincrement())
  number        String         @unique
  clientId      Int            @map("client_id")
  userId        Int            @map("user_id")
  quoteId       Int?           @unique @map("quote_id")
  currency      Currency       @default(usd)
  exchangeRate  Decimal?       @map("exchange_rate") @db.Decimal(14, 4)
  subtotal      Decimal        @db.Decimal(12, 2)
  ivaTotal      Decimal        @map("iva_total") @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  totalBs       Decimal?       @map("total_bs") @db.Decimal(14, 2)
  status        InvoiceStatus  @default(activa)
  paymentMethod String         @default("efectivo") @map("payment_method")
  createdAt     DateTime       @default(now()) @map("created_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  client        Client         @relation(fields: [clientId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  quote         Quote?         @relation("QuoteToInvoice", fields: [quoteId], references: [id])
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoiceId  Int     @map("invoice_id")
  productId  Int     @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  ivaPercent Decimal @map("iva_percent") @db.Decimal(5, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model PurchaseInvoice {
  id            Int              @id @default(autoincrement())
  number        String           @unique
  supplierId    Int              @map("supplier_id")
  userId        Int              @map("user_id")
  currency      Currency         @default(usd)
  exchangeRate  Decimal?         @map("exchange_rate") @db.Decimal(14, 4)
  subtotal      Decimal          @db.Decimal(12, 2)
  ivaTotal      Decimal          @map("iva_total") @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  totalBs       Decimal?         @map("total_bs") @db.Decimal(14, 2)
  status        PurchaseStatus   @default(pedido)
  paymentMethod String           @default("efectivo") @map("payment_method")
  dueDate       DateTime?        @map("due_date")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  cancelledAt   DateTime?        @map("cancelled_at")
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  items         PurchaseInvoiceItem[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                Int              @id @default(autoincrement())
  purchaseInvoiceId Int              @map("purchase_invoice_id")
  productId         Int              @map("product_id")
  quantity          Int
  unitPrice         Decimal          @map("unit_price") @db.Decimal(12, 2)
  ivaPercent        Decimal          @map("iva_percent") @db.Decimal(5, 2)
  subtotal          Decimal          @db.Decimal(12, 2)
  purchaseInvoice   PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_items")
}

model CashClose {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  expectedTotal  Decimal  @map("expected_total") @db.Decimal(12, 2)
  declaredTotal  Decimal  @map("declared_total") @db.Decimal(12, 2)
  difference     Decimal  @db.Decimal(12, 2)
  closeDate      DateTime @map("close_date")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id])

  @@map("cash_closes")
}
